# ==============================================================================
# DevPath Backend Environment Variables (.env.example)
# ==============================================================================

# Server Port (Render sets this automatically via process.env.PORT)
PORT=5000

# Environment Mode ('development' or 'production')
NODE_ENV=production

# Frontend Origin for strict CORS (e.g. https://your-devpath.vercel.app)
FRONTEND_URL=https://your-devpath.vercel.app

# Additional Allowed CORS Origins (comma-separated, optional)
ADDITIONAL_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Connections
# ------------------------------------------------------------------------------
# 1. DATABASE_URL: Session/Transaction Pooler connection string for runtime API queries.
#    Supabase pooled connection on port 6543 (or 5432) with ?pgbouncer=true&connection_limit=1
#    Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2. DIRECT_URL: Direct PostgreSQL connection string (bypasses PgBouncer for migrations & DDL).
#    Supabase direct connection on port 5432.
#    Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# Single-User Security
# ------------------------------------------------------------------------------
# Secret key protecting mutation operations (POST, PUT, PATCH, DELETE) in production.
# Leave blank or omit in local development. When configured on Render, enter this same
# value in DevPath Settings > Cloud Production Access Secret or VITE_APP_ACCESS_SECRET.
APP_ACCESS_SECRET="your-secure-random-32-char-secret"
