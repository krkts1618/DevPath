{
  "name": "devpath-backend",
  "version": "1.0.0",
  "description": "DevPath Dynamic Roadmap Management Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=384 src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "seed:validate": "node prisma/validate-seed.js",
    "test": "node tests/production-readiness.test.mjs",
    "test:readiness": "node tests/production-readiness.test.mjs",
    "test:lifecycle": "node tests/run-all-tests.js",
    "cron:reminders": "node src/scripts/process-reminders.js"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.21.1"
  }
}
