# ==============================================================================
# DevPath Frontend Environment Variables (.env.example)
# ==============================================================================

# Backend API Base URL
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api

# Production on Vercel (points to your Render backend service):
# VITE_API_BASE_URL=https://devpath-api.onrender.com/api

# ------------------------------------------------------------------------------
# Single-User Security
# ------------------------------------------------------------------------------
# Optional build-time access secret matching APP_ACCESS_SECRET on your backend.
# You can also configure this dynamically in the browser at Settings > Cloud Production Access Secret.
# VITE_APP_ACCESS_SECRET=your-secure-random-32-char-secret
